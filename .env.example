# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://laundrypadi.vercel.app

# ---------- Firebase (client) : Project settings > Your apps > Web app ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only, NEVER prefix with NEXT_PUBLIC) ----------
# Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes and the \n characters exactly as in the JSON file
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------- Cloudinary (unsigned uploads, used with direct fetch) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------- Public support contact (optional, shown on /help) ----------
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------- Paystack billing (server only) ----------
# Start with a TEST key (sk_test_...). Switch to sk_live_... only when you are ready to take real money.
PAYSTACK_SECRET_KEY=
# Optional. If empty, the monthly plan is created automatically the first time someone subscribes.
PAYSTACK_PLAN_CODE=
# false = shops work even if unpaid. true = unpaid/cancelled shops stop taking online booking requests.
NEXT_PUBLIC_BILLING_ENFORCED=false

# ---------- Web push notifications (optional) ----------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Platform admin (server only) ----------
# Comma-separated emails allowed into /admin. Never stored in Firestore, so it can't be granted
# by editing a document — only by changing this environment variable and redeploying.
ADMIN_EMAILS=
